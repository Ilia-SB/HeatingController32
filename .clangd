CompileFlags:
  # Use the compile_commands.json generated by PlatformIO
  CompilationDatabase: .

  # Remove problematic ESP32-specific compiler flags that clangd doesn't understand
  Remove:
    - "-mlongcalls"
    - "-fstrict-volatile-bitfields"
    - "-fno-tree-switch-conversion"
    - "-mtext-section-literals"
    - "-mfix-esp32-psram-cache-issue"
    - "-mfix-esp32-psram-cache-strategy=*"

  # Add additional flags
  Add:
    # Treat .ino files as C++
    - "-xc++"
    # Suppress warnings from Arduino/ESP32 framework
    - "-Wno-unknown-pragmas"
    - "-Wno-unknown-attributes"
    - "-Wno-error"
    - "-ferror-limit=0"
    # Add toolchain system headers (use -isystem to suppress errors from them)
    - "-isystem"
    - "C:\\Users\\Ilia\\.platformio\\packages\\toolchain-xtensa-esp32\\xtensa-esp32-elf\\include"
    - "-isystem"
    - "C:\\Users\\Ilia\\.platformio\\packages\\toolchain-xtensa-esp32\\lib\\gcc\\xtensa-esp32-elf\\8.4.0\\include"
    - "-isystem"
    - "C:\\Users\\Ilia\\.platformio\\packages\\framework-arduinoespressif32\\cores\\esp32"
    - "-isystem"
    - "C:\\Users\\Ilia\\.platformio\\packages\\framework-arduinoespressif32\\tools\\sdk\\esp32\\include"

Diagnostics:
  # Suppress diagnostics from framework paths
  Includes:
    IgnoreHeader: ".*platformio.*"
  
  # Suppress noisy diagnostics from ESP32/Arduino framework headers
  Suppress:
    - "pp_including_mainfile_in_preamble"
    - "drv_unknown_argument"
    - "err_expected_body"
    - "ext_vla_in_struct"
    - "ovl_no_viable_member_function_in_call"
    - "err_expected"
    - "ovl_no_viable_constructor"
    - "ovl_no_matching_member_function"
    - "-Wvla-extension"
    - "err_typedef_redefinition"
    - "err_constexpr_body_invalid_stmt"
    - "err_typecheck_assign_const"
    - "err_expected_semi_after_expr"
    - "err_constexpr_non_literal_return"
    - "err_constexpr_no_return_stmt"
    - "err_undeclared_var_use"
    - "err_*"
    - "ext_*"
    - "warn_*"
  UnusedIncludes: None
  MissingIncludes: Relaxed
  # Suppress errors from system headers (Arduino framework, ESP-IDF)
  SuppressInSystemHeader: true
  ClangTidy:
    Remove: "*"

InlayHints:
  Enabled: No
  ParameterNames: No
  DeducedTypes: No

Index:
  Background: Build

